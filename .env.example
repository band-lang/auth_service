# -----------------------------------------------------------------------------
# Auth Service — environment configuration
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.
# -----------------------------------------------------------------------------

# ---- Database (PostgreSQL) --------------------------------------------------
# Async SQLAlchemy connection string, e.g. postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_service
# Separate database used exclusively when running the test suite
TEST_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_service_test

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Full Redis URL, used by the SAQ task queue
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=15

# ---- SMTP / Email delivery -----------------------------------------------------
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=no-reply@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587

# ---- App ------------------------------------------------------------------
APP_NAME=Auth service

# ---- Security / Tokens ------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
